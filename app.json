{
  "expo": {
    "name": "Fitme Project",
    "slug": "fitme-project",
    "version": "1.9.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["rc-d91405cd5f"],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitmeproject.ios",
      "associatedDomains": [
        "webcredentials:app.fitmeproject.com",
        "webcredentials:fitmeproject.com",
        "applinks:app.fitmeproject.com",
        "applinks:fitmeproject.com",
        "activitycontinuation:app.fitmeproject.com",
        "activitycontinuation:fitmeproject.com",
        "appclips:app.fitmeproject.com",
        "appclips:fitmeproject.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "appStoreUrl": "https://apps.apple.com/app/id6741153628"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/nunito-sans/400Regular/NunitoSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/nunito-sans/600SemiBold/NunitoSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/nunito-sans/700Bold/NunitoSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/400Regular/IBMPlexMono_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/600SemiBold/IBMPlexMono_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "mobile",
          "organization": "fitme"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7d15486d-888e-45a5-9843-ef80cceb5f18"
      }
    },
    "owner": "kprovorov"
  }
}
