{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup",
      "command": "./scripts/setup.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Destroy Supabase stack",
      "command": "./scripts/settle.sh",
      "icon": "configure",
      "runOnSettle": true
    },
    {
      "name": "Run all",
      "command": "pnpm dev",
      "icon": "play"
    },
    {
      "name": "Run mobile",
      "command": "pnpm mobile dev",
      "icon": "play"
    },
    {
      "name": "Build mobile",
      "command": "pnpm ios --no-bundler",
      "icon": "build"
    },
    {
      "name": "Release iOS (local)",
      "command": "./scripts/release-ios-local.sh",
      "icon": "build"
    },
    {
      "name": "Preview iOS (local)",
      "command": "./scripts/preview-ios-local.sh",
      "icon": "build"
    },
    {
      "name": "Run web",
      "command": "pnpm dev:web",
      "icon": "play",
      "previewUrl": "http://localhost:3000"
    },
    {
      "name": "Run site",
      "command": "pnpm dev:site",
      "icon": "play",
      "previewUrl": "http://localhost:3001"
    },
    {
      "name": "Run MCP",
      "command": "pnpm dev:mcp",
      "icon": "play"
    },
    {
      "name": "Run API",
      "command": "pnpm dev:api",
      "icon": "play"
    },
    {
      "name": "Run webhooks",
      "command": "pnpm dev:webhooks",
      "icon": "play"
    },
    {
      "name": "Run arnold",
      "command": "pnpm dev:arnold",
      "icon": "play"
    },
    {
      "name": "Start Supabase",
      "command": "pnpm db start",
      "icon": "play"
    },
    {
      "name": "Test",
      "command": "pnpm test",
      "icon": "test"
    },
    {
      "name": "Check",
      "command": "pnpm check && pnpm typecheck",
      "icon": "lint"
    }
  ]
}
