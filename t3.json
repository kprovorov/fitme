{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup",
      "command": "./scripts/setup.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Destroy Supabase stack",
      "command": "./scripts/settle.sh",
      "icon": "configure",
      "runOnSettle": true
    },
    {
      "name": "Run all",
      "command": "./scripts/with-dev-env.sh -- pnpm dev",
      "icon": "play"
    },
    {
      "name": "Run mobile",
      "command": "./scripts/with-dev-env.sh Mobile -- pnpm mobile dev",
      "icon": "play"
    },
    {
      "name": "Build mobile",
      "command": "./scripts/with-dev-env.sh Mobile -- pnpm ios --no-bundler",
      "icon": "build"
    },
    {
      "name": "Release iOS (local)",
      "command": "./scripts/release-ios-local.sh",
      "icon": "build"
    },
    {
      "name": "Preview iOS (local)",
      "command": "./scripts/preview-ios-local.sh",
      "icon": "build"
    },
    {
      "name": "Run web",
      "command": "./scripts/with-dev-env.sh Web -- pnpm dev:web",
      "icon": "play",
      "previewUrl": "http://localhost:3000"
    },
    {
      "name": "Run site",
      "command": "./scripts/with-dev-env.sh Site -- pnpm dev:site",
      "icon": "play",
      "previewUrl": "http://localhost:3001"
    },
    {
      "name": "Run MCP",
      "command": "./scripts/with-dev-env.sh Mcp -- pnpm dev:mcp",
      "icon": "play"
    },
    {
      "name": "Run API",
      "command": "./scripts/with-dev-env.sh Api -- pnpm dev:api",
      "icon": "play"
    },
    {
      "name": "Run webhooks",
      "command": "./scripts/with-dev-env.sh Webhooks -- pnpm dev:webhooks",
      "icon": "play"
    },
    {
      "name": "Run arnold",
      "command": "./scripts/with-dev-env.sh Arnold -- pnpm dev:arnold",
      "icon": "play"
    },
    {
      "name": "Run library",
      "command": "./scripts/with-dev-env.sh Library -- pnpm dev:library",
      "icon": "play"
    },
    {
      "name": "Start Supabase",
      "command": "pnpm db start",
      "icon": "play"
    },
    {
      "name": "Test",
      "command": "pnpm test",
      "icon": "test"
    },
    {
      "name": "Check",
      "command": "pnpm check && pnpm typecheck",
      "icon": "lint"
    }
  ]
}
