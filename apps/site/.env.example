# App Store
NEXT_PUBLIC_APPSTORE_ID=
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/app/apple-store/id6741153628

# Contact
NEXT_PUBLIC_SUPPORT_EMAIL=

# Social links shown in the footer
NEXT_PUBLIC_TWITTER_URL=https://x.com/fitmeproject
NEXT_PUBLIC_THREADS_URL=https://www.threads.net/@fitmeprojectcom
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fitmeprojectcom

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Sentry (fitme-site): browser errors and page-load traces; unset (local)
# sends nothing. Set on Vercel by the Sentry integration.
NEXT_PUBLIC_SENTRY_DSN=
# Build time: source map upload for the release (VERCEL_GIT_COMMIT_SHA); no
# token skips the upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
