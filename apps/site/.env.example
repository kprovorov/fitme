# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (a local toggle); a variable
# Infisical holds always wins over it.

# App Store
NEXT_PUBLIC_APPSTORE_ID=
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/app/apple-store/id6741153628

# Contact
NEXT_PUBLIC_SUPPORT_EMAIL=

# Social links shown in the footer
NEXT_PUBLIC_TWITTER_URL=https://x.com/fitmeproject
NEXT_PUBLIC_THREADS_URL=https://www.threads.net/@fitmeprojectcom
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fitmeprojectcom

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# The fitme-site Sentry project: browser errors and page loads. Unset (local,
# CI): nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: each event's environment and release, inlined
# into the bundle.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
