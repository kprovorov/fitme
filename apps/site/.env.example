# App Store
NEXT_PUBLIC_APPSTORE_ID=
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/app/apple-store/id6741153628

# Contact
NEXT_PUBLIC_SUPPORT_EMAIL=

# Social links shown in the footer
NEXT_PUBLIC_TWITTER_URL=https://x.com/fitmeproject
NEXT_PUBLIC_THREADS_URL=https://www.threads.net/@fitmeprojectcom
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fitmeprojectcom

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# The fitme-site Sentry project: browser errors and page-load traces go here,
# configured from @fitme/observability. Unset (local, CI): nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=

# Build only: uploads the browser source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with, inlined into the bundle at
# build time. Unset: development, no release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
