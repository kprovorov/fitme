# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (the worktree's database URL, a
# local toggle); a variable Infisical holds always wins over it.

PORT=3002

# The Clerk instance that issues the OAuth access tokens MCP clients send: the
# development instance everywhere but production. Unset: the MCP endpoint
# answers 500.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=mcp. Not in Infisical: it's this worktree's own stack, and
# scripts/setup.sh writes it into .env with the stack's real pooler port (the
# password is the local-only one from supabase/roles.sql). Service-role
# strength: server environments only.
# Unset: the MCP endpoint answers 500.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=mcp

# The Library API (apps/library, pnpm dev:library) and the MCP server's bearer
# for it (the same value as the Library API's LIBRARY_MCP_SECRET). Either
# unset: list_exercises, get_exercise and Plan writes answer a "not
# configured" tool error.
LIBRARY_URL=http://localhost:3006
LIBRARY_MCP_SECRET=

# The server's public URL, advertised as the OAuth protected resource when it
# differs from the request URL (production). Unset: the request URL.
MCP_PUBLIC_URL=

# OpenAI's Apps SDK domain verification token (public), served at
# /.well-known/openai-apps-challenge. Unset: that path answers 404.
OPENAI_APPS_CHALLENGE=

# The fitme-mcp Sentry project. Unset (local, tests, CI): nothing is sent.
SENTRY_DSN=

# `pnpm mcp test:integration` only: the Clerk development instance's secret
# key, which runs the Clerk OAuth suite. Unset: that suite is skipped.
CLERK_DEV_SECRET_KEY=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: each event's environment and release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
