PORT=3002

# Supabase project used by the per-user tools. Use the public anon key only —
# never a service-role key: every query runs as the caller via their bearer
# token, so RLS enforces ownership. SUPABASE_URL/auth/v1 is also the OAuth
# authorization server MCP clients sign in with. Without these, only the
# public catalog tools work.
SUPABASE_URL=http://127.0.0.1:51321
SUPABASE_ANON_KEY=
# Optional: the server's public URL, advertised as the OAuth protected
# resource, when it differs from the request URL (e.g. behind a proxy).
# MCP_PUBLIC_URL=https://mcp.fitmeproject.com
