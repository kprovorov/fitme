PORT=3002

# Clerk instance that issues the OAuth access tokens MCP clients send (the
# authorization server). Use the development instance everywhere except
# production. Without these the MCP endpoint answers 500.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# The fitme login's Supavisor transaction-pooler URL. Every user tool runs as
# the caller through asUser (ADR 0003), so RLS enforces ownership. Keep
# application_name=mcp so database activity stays attributable. Service-role
# strength: server environments only. Required: without it the MCP endpoint
# answers 500. Locally, the pooler port is in `supabase status --output-format json`.
# On hosted projects the user is fitme.<project-ref>.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=mcp
# The Exercise Library API (apps/exercises) the Exercise tools search, plan
# writes check their Exercise slugs against and reads name Exercises through.
# Locally, `pnpm dev:exercises` on :3006, with this same secret set as
# EXERCISES_MCP_SECRET in apps/exercises/.env. In production
# https://exercises.fitmeproject.com with the production secret (Vercel,
# Sensitive); never use it locally. Unset: list_exercises, get_exercise and
# Plan writes answer a "not configured" tool error; reads name Exercises from
# their slugs.
EXERCISES_URL=http://localhost:3006
EXERCISES_MCP_SECRET=local-only-mcp-exercises-secret-0000000000000000
# The server's public URL, advertised as the OAuth protected resource. Set it
# in production (Vercel): MCP clients reject a resource that doesn't match the
# URL they connected to. Defaults to the request URL.
# MCP_PUBLIC_URL=https://mcp.fitmeproject.com

# The fitme-mcp Sentry project: unhandled errors on the MCP endpoint,
# unexpected tool failures (a Postgres error, an unknown exception) and
# request traces go here, through @fitme/observability. Unset (local, tests,
# CI): nothing is sent, errors only reach the logs.
SENTRY_DSN=

# Build only: uploads the bundle's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with. Unset: development, no
# release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
