PORT=3002

# Clerk instance that issues the OAuth access tokens MCP clients send (the
# authorization server). Use the development instance everywhere except
# production. Without these the MCP endpoint answers 500.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# The fitme login's Supavisor transaction-pooler URL for the tools on
# @fitme/services, which run as the caller through asUser (ADR 0003). Keep
# application_name=mcp so database activity stays attributable. Service-role
# strength: server environments only. Required: without it the MCP endpoint
# answers 500. Locally, the pooler port is in `supabase status --output-format json`.
# On hosted projects the user is fitme.<project-ref>.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=mcp
# Supabase project used by the user tools. Use the public anon key only —
# never a service-role key: every query runs as the caller with a token the
# server signs for them (below), so RLS enforces ownership. Without these,
# user tools return a "not configured" error.
SUPABASE_URL=http://127.0.0.1:51321
SUPABASE_ANON_KEY=
# The server's public URL, advertised as the OAuth protected resource. Set it
# in production (Vercel): MCP clients reject a resource that doesn't match the
# URL they connected to. Defaults to the request URL.
# MCP_PUBLIC_URL=https://mcp.fitmeproject.com
# Private ES256 JWK the server signs short-lived Supabase tokens with (ADR
# 0002). Required: without it the MCP endpoint answers 500. As powerful as
# the service-role key: keep it in this server's env only. In production,
# generate one with `supabase gen signing-key --algorithm ES256` and import its
# public half on the Supabase project as a standby key.
# The value below is the committed DEVELOPMENT key: local stacks trust it
# (packages/supabase/supabase/local-only-signing-keys.json), nothing hosted may.
SUPABASE_JWT_SIGNING_KEY='{"kty":"EC","kid":"2ea81bba-4dd5-4a33-8f57-b627edd1c356","use":"sig","key_ops":["sign","verify"],"alg":"ES256","ext":true,"d":"6TdHWuV-1uhZYFBU9bim2i3ynd1lugKoyjejpIa8nJ8","crv":"P-256","x":"IZ-EcgKysosuNxJpPcIkc772zQSUeS_owqBW8c0JSvE","y":"mREIDrgQidSAUheqlzqaPbJQdWCxrrVJEUzcSm9JZzE"}'
