{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    },
    "e2e-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_E2E_ENABLED": "true",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "placeholder",
        "EXPO_PUBLIC_SENTRY_DSN": "placeholder"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "X75M2KSBQL",
        "ascAppId": "6741153628",
        "metadataPath": "./store.config.json",
        "bundleIdentifier": "com.fitmeproject.ios"
      }
    }
  }
}
