{
  "name": "@fitme/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "dev": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "prebuild": "expo prebuild",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "test": "jest --ci --passWithNoTests",
    "test:e2e": "maestro test e2e/flows/**/*.yaml",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@rn-primitives/.*|@sentry/react-native|native-base|react-native-svg|uniwind)"
    ]
