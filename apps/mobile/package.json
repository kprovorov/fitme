{
  "name": "@fitme/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "api:types": "openapi-typescript ../api/openapi.json --output lib/api/schema.ts && biome check --write --unsafe lib/api/schema.ts",
    "dev": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "prebuild": "expo prebuild",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "test": "jest --ci --passWithNoTests",
    "test:e2e": "maestro test e2e/flows/**/*.yaml",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-native-nitro-modules$": "<rootDir>/test-utils/nitro-modules.ts"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test-utils/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/after-each.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@rn-primitives/.*|@sentry/.*|native-base|react-native-svg|uniwind|mdast-.*|micromark.*|unist-.*|decode-named-character-reference|character-entities|devlop|markdown-table|longest-streak|zwitch|ccount|escape-string-regexp)"
    ]
  },
  "dependencies": {
    "@assistant-ui/eve": "0.0.24",
    "@assistant-ui/react-native": "0.1.48",
    "@clerk/expo": "4.13.0",
    "@expo-google-fonts/ibm-plex-mono": "0.3.0",
    "@expo-google-fonts/nunito-sans": "0.3.0",
    "@expo/metro-runtime": "58.0.14",
    "@expo/ui": "58.0.20",
    "@fitme/core": "workspace:*",
    "@fitme/design-tokens": "workspace:*",
    "@fitme/exercise-library": "workspace:*",
    "@fitme/observability": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@legendapp/list": "3.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/accordion": "1.5.2",
    "@rn-primitives/avatar": "1.5.2",
    "@rn-primitives/label": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/separator": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/table": "1.5.2",
    "@rn-primitives/types": "1.5.2",
    "@segment/analytics-react-native": "2.24.2",
    "@segment/sovran-react-native": "1.1.5",
    "@sentry/react-native": "8.28.0",
    "@stardazed/streams-text-encoding": "1.0.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.3",
    "@ungap/structured-clone": "1.4.0",
    "ai": "7.0.142",
    "clsx": "2.1.1",
    "css-to-react-native": "3.2.0",
    "date-fns": "4.4.0",
    "eve": "0.80.0",
    "expo": "58.0.14",
    "expo-blur": "58.0.4",
    "expo-constants": "58.0.12",
    "expo-dev-client": "58.0.14",
    "expo-font": "58.0.8",
    "expo-glass-effect": "58.0.4",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.15",
    "expo-linking": "58.0.13",
    "expo-localization": "58.0.4",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "expo-status-bar": "58.0.3",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-video": "58.0.11",
    "expo-web-browser": "58.0.6",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-purchases": "10.14.0",
    "react-native-purchases-ui": "10.14.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-query-kit": "3.4.0",
    "react-syntax-highlighter": "16.1.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.0",
    "uniwind": "1.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "babel-plugin-react-compiler": "1.0.0",
    "expo-mcp": "0.2.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "openapi-typescript": "7.13.0",
    "react-query-external-sync": "2.2.3",
    "sf-symbols-typescript": "2.2.0",
    "socket.io-client": "4.8.4",
    "test-renderer": "1.3.1",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest",
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@hookform/resolvers",
          "@rn-primitives/portal",
          "@rn-primitives/slot",
          "@rn-primitives/types",
          "class-variance-authority",
          "date-fns",
          "date-fns-tz",
          "react-query-kit",
          "tailwindcss-animate"
        ]
      }
    },
    "autolinking": {
      "exclude": [
        "@clerk/expo"
      ]
    }
  }
}
