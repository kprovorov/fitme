# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (a local toggle); a variable
# Infisical holds always wins over it.

# The Public API (apps/api, pnpm dev:api). Unset: its writes fail and the
# minimum version check is skipped.
EXPO_PUBLIC_API_URL=http://localhost:3003

# The Library API (apps/library, pnpm dev:library): Exercise names, thumbnails
# and videos. Unset: every Exercise shows its slug's name.
EXPO_PUBLIC_LIBRARY_URL=http://localhost:3006

# Arnold (apps/arnold, pnpm dev:arnold).
EXPO_PUBLIC_ARNOLD_URL=http://localhost:3005

# Clerk (the development instance locally).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Native Apple and Google sign-in: enable only after docs/agents/mobile-auth.md.
# The Google ids are public; app.config.ts reads them at prebuild.
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# RevenueCat public API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# The fitme-mobile Sentry project; ignored in __DEV__ builds.
EXPO_PUBLIC_SENTRY_DSN=

# Segment.
EXPO_PUBLIC_SEGMENT_WRITE_KEY=

# E2E builds only (set by the EAS e2e profile): stands in for RevenueCat and
# shows the E2E affordances.
EXPO_PUBLIC_E2E_ENABLED=false

# Dev builds only: sync React Query and storage to the desktop devtools app
# (react-query-external-sync, port 42831); leave unset unless it's running.
EXPO_PUBLIC_DEVTOOLS_SYNC=
