# Base
EXPO_PUBLIC_APP_URL=

# Fitme API (apps/api); unset skips the minimum version check
EXPO_PUBLIC_API_URL=http://localhost:3003

# Supabase
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:51321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (development instance locally)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Enable only after configuring the matching Clerk social connection and native app.
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# Sentry
EXPO_PUBLIC_SENTRY_DSN=

# Segment
EXPO_PUBLIC_SEGMENT_WRITE_KEY=

# The Library API (apps/library, `pnpm dev:library`): Exercise
# names, thumbnails and videos, called with the User's Clerk session token
EXPO_PUBLIC_LIBRARY_URL=http://localhost:3006

# Arnold (apps/arnold, `pnpm dev:arnold`)
EXPO_PUBLIC_ARNOLD_URL=http://localhost:3005

# Dev builds only: sync React Query and storage to the desktop devtools app
# (react-query-external-sync, port 42831); leave unset unless it is running
EXPO_PUBLIC_DEVTOOLS_SYNC=
