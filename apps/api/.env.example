PORT=3003

# Minimum supported app version (x.y.z), served by GET /v1/client-config.
# MIN_APP_VERSION applies to every platform; a platform's own variable, when
# set and x.y.z, overrides it (so it also sets web's). Neither valid: no minimum.
MIN_APP_VERSION=
MIN_APP_VERSION_IOS=
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_WEB=

# The Clerk instance's PEM public key (pnpm --silent db clerk:jwt-key): every
# User-data route verifies the bearer session token against it, without a
# network call. One instance per deployment: production the production
# instance, everywhere else the development instance. Unset: those routes
# answer a reported 500, never serve without auth.
CLERK_JWT_KEY=

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=api. Locally the pooler port comes from
# `supabase status --output-format json` (endpoints."pooler.sql"); the password
# is from supabase/roles.sql. Service-role strength: server environments only.
# Unset: User-data routes answer a reported 500.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=api

# Upstash Redis (Vercel Marketplace), where each User's requests are counted
# (by Clerk id; /health and the global routes never). Unset outside production
# or on a Vercel preview: an in-memory limiter counts per process; unset in
# production (NODE_ENV production) fails at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests a User may make per window (a fixed window): 300 per 60 seconds
# unset. Positive integers only; anything else fails at startup. Over the
# limit: 429 rate_limited with Retry-After.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=

# The Library API (apps/library) every Exercise slug a Plan write carries is
# checked against: http://localhost:3006 locally (pnpm dev:library),
# https://library.fitmeproject.com deployed. LIBRARY_PUBLIC_API_SECRET is the
# Public API's bearer for it, the same value as the Library API's
# (LIBRARY_PUBLIC_API_SECRET in apps/library/.env; openssl rand -hex 32; this
# one is local only). Either unset: POST /v1/plans answers a
# reported 503 exercise_library_unavailable.
LIBRARY_URL=http://localhost:3006
LIBRARY_PUBLIC_API_SECRET=local-only-exercises-api-secret-0000000000000000

# The fitme-api Sentry project: unhandled errors and request traces go here,
# through @fitme/observability. Unset (local, tests, CI): nothing is sent,
# errors only reach the logs.
SENTRY_DSN=

# Build only: uploads the bundle's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with. Unset: development, no
# release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
