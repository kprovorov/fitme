PORT=3003

# Minimum supported mobile app version per platform (x.y.z), served by
# GET /v1/client-config. Unset means no minimum.
MIN_APP_VERSION_IOS=
MIN_APP_VERSION_ANDROID=

# The Clerk instance's PEM public key (pnpm --silent db clerk:jwt-key): every
# User-data route verifies the bearer session token against it, without a
# network call. One instance per deployment: production the production
# instance, everywhere else the development instance. Unset: those routes
# answer a reported 500, never serve without auth.
CLERK_JWT_KEY=

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=api. Locally the pooler port comes from
# `supabase status --output-format json` (endpoints."pooler.sql"); the password
# is from supabase/roles.sql. Service-role strength: server environments only.
# Unset: User-data routes answer a reported 500.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=api

# The fitme-api Sentry project: unhandled errors and request traces go here,
# through @fitme/observability. Unset (local, tests, CI): nothing is sent,
# errors only reach the logs.
SENTRY_DSN=

# Build only: uploads the bundle's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with. Unset: development, no
# release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
