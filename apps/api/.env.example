# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (the worktree's database URL, a
# local toggle); a variable Infisical holds always wins over it.

PORT=3003

# Minimum supported app version (x.y.z), served by GET /v1/client-config.
# MIN_APP_VERSION applies to every platform; a platform's own variable, when
# set and x.y.z, overrides it (so it also sets web's). Neither valid: no
# minimum. Deployed, these live on Vercel only, never in Infisical.
MIN_APP_VERSION=
MIN_APP_VERSION_IOS=
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_WEB=

# The Clerk instance's PEM public key (pnpm --silent db clerk:jwt-key): every
# User-data route verifies the bearer session token against it, without a
# network call. Production the production instance, everywhere else the
# development instance. Unset: those routes answer a reported 500.
CLERK_JWT_KEY=

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=api. Not in Infisical: it's this worktree's own stack, and
# scripts/setup.sh writes it into .env with the stack's real pooler port (the
# password is the local-only one from supabase/roles.sql). Service-role
# strength: server environments only.
# Unset: User-data routes answer a reported 500.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=api

# Upstash Redis, where each User's requests are counted. Unset outside
# production or on a Vercel preview: an in-memory limiter; unset in production
# fails at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests a User may make per fixed window; unset: 300 per 60 seconds.
# Positive integers only; anything else fails at startup.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=

# The Library API (apps/library, pnpm dev:library) Plan writes check their
# Exercise slugs against, and the Public API's bearer for it (the same value
# as the Library API's LIBRARY_PUBLIC_API_SECRET). Either unset:
# POST /v1/plans answers a reported 503 library_unavailable.
LIBRARY_URL=http://localhost:3006
LIBRARY_PUBLIC_API_SECRET=

# The fitme-api Sentry project. Unset (local, tests, CI): nothing is sent.
SENTRY_DSN=

# `pnpm api clerk:check` only: the Clerk development instance's secret key
# (sk_test_…) and the running Public API it checks.
CLERK_SECRET_KEY=
API_URL=http://localhost:3003

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: each event's environment and release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
