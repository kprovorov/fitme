{
  "name": "@fitme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/index.ts",
    "openapi": "tsx src/openapi.ts",
    "start": "node dist/node/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fitme/core": "workspace:*",
    "@fitme/observability": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.8.0",
    "hono": "^4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "22.15.21",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
