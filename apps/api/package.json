{
  "name": "@fitme/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clerk:check": "tsx scripts/check-clerk-session.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "merge:identities": "tsx scripts/merge-identities.ts",
    "openapi": "tsx src/openapi.ts && oxfmt --write openapi.json",
    "start": "node dist/node/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.29.0",
    "@fitme/core": "workspace:*",
    "@fitme/db": "workspace:*",
    "@fitme/library-bundle": "workspace:*",
    "@fitme/observability": "workspace:*",
    "@fitme/rate-limit": "workspace:*",
    "@fitme/services": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.12.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  }
}
