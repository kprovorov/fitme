{
  "info": {
    "title": "Fitme API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://api.fitmeproject.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "description": "The User's Clerk session token",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "ClientConfig": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "minimumVersion": {
                "type": "object",
                "properties": {
                  "android": {
                    "type": "string",
                    "nullable": true,
                    "description": "The oldest supported app version (`x.y.z`), or `null` for no minimum.",
                    "example": "1.10.0"
                  },
                  "ios": {
                    "type": "string",
                    "nullable": true,
                    "description": "The oldest supported app version (`x.y.z`), or `null` for no minimum.",
                    "example": "1.10.0"
                  }
                },
                "required": [
                  "android",
                  "ios"
                ]
              }
            },
            "required": [
              "minimumVersion"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CoachModels": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "defaultId": {
                "type": "string",
                "description": "The model the Coach uses when a turn names none.",
                "example": "openai/gpt-5.5"
              },
              "models": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CoachModel"
                }
              }
            },
            "required": [
              "defaultId",
              "models"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CoachModel": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "example": "openai/gpt-5.5"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "id",
          "label"
        ]
      },
      "MuscleGroupItem": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MuscleGroup"
          },
          "name": {
            "type": "string",
            "example": "Chest"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MuscleGroup": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "forearms",
          "abs",
          "obliques",
          "quadriceps",
          "hamstrings",
          "glutes",
          "calves",
          "traps",
          "lats",
          "lower-back",
          "cardio",
          "full-body"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "age": {
            "type": "number",
            "example": 30
          },
          "gender": {
            "type": "string",
            "example": "female"
          },
          "height": {
            "type": "number",
            "description": "In `units.height`",
            "example": 170.5
          },
          "measurement_system": {
            "type": "string",
            "description": "`metric`, `us` or `uk`",
            "example": "metric"
          },
          "units": {
            "type": "object",
            "properties": {
              "height": {
                "type": "string",
                "description": "`cm` (metric) or `in` (us, uk)",
                "example": "cm"
              },
              "weight": {
                "type": "string",
                "description": "`kg` (metric) or `lbs` (us, uk)",
                "example": "kg"
              }
            },
            "required": [
              "height",
              "weight"
            ],
            "description": "The units every height and weight of the User is stored and shown in"
          },
          "weight": {
            "type": "number",
            "description": "In `units.weight`",
            "example": 60.25
          }
        },
        "required": [
          "age",
          "gender",
          "height",
          "measurement_system",
          "units",
          "weight"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/client-config": {
      "get": {
        "summary": "Mobile client config",
        "responses": {
          "200": {
            "description": "The mobile app's config: its minimum version per platform",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "public, max-age=300, s-maxage=300"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          }
        }
      }
    },
    "/v1/coach/models": {
      "get": {
        "summary": "Coach models",
        "responses": {
          "200": {
            "description": "Every model the Coach accepts, in list order",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "public, max-age=300, s-maxage=300"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachModels"
                }
              }
            }
          }
        }
      }
    },
    "/v1/muscle-groups": {
      "get": {
        "summary": "List muscle groups",
        "responses": {
          "200": {
            "description": "Every muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MuscleGroupItem"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/muscle-groups/{muscleGroup}": {
      "get": {
        "summary": "Get one muscle group",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/MuscleGroup"
            },
            "required": true,
            "name": "muscleGroup",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MuscleGroupItem"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get the User's Profile",
        "responses": {
          "200": {
            "description": "The User's Profile, or `null` without one",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/Profile"
                        },
                        {
                          "nullable": true
                        }
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
