{
  "info": {
    "title": "Fitme API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://api.fitmeproject.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "description": "The User's Clerk session token",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "ClientConfig": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "minimumVersion": {
                "type": "object",
                "properties": {
                  "android": {
                    "type": "string",
                    "nullable": true,
                    "description": "The oldest supported app version (`x.y.z`), or `null` for no minimum.",
                    "example": "1.10.0"
                  },
                  "ios": {
                    "type": "string",
                    "nullable": true,
                    "description": "The oldest supported app version (`x.y.z`), or `null` for no minimum.",
                    "example": "1.10.0"
                  }
                },
                "required": [
                  "android",
                  "ios"
                ]
              }
            },
            "required": [
              "minimumVersion"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CoachModels": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "defaultId": {
                "type": "string",
                "description": "The model the Coach uses when a turn names none.",
                "example": "openai/gpt-5.5"
              },
              "models": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CoachModel"
                }
              }
            },
            "required": [
              "defaultId",
              "models"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CoachModel": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "example": "openai/gpt-5.5"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "id",
          "label"
        ]
      },
      "MuscleGroupItem": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/MuscleGroup"
          },
          "name": {
            "type": "string",
            "example": "Chest"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MuscleGroup": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "forearms",
          "abs",
          "obliques",
          "quadriceps",
          "hamstrings",
          "glutes",
          "calves",
          "traps",
          "lats",
          "lower-back",
          "cardio",
          "full-body"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "PlanSummary": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "nullable": true,
            "description": "ISO 8601",
            "example": "2026-10-20T09:00:00+00:00"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Three full-body days"
          },
          "experience_level": {
            "type": "string",
            "description": "`beginner`, `intermediate` or `advanced`",
            "example": "intermediate"
          },
          "frequency": {
            "type": "integer",
            "description": "Workouts a week",
            "example": 3
          },
          "goal": {
            "type": "string",
            "example": "build_muscle"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean",
            "description": "The User's active Plan; at most one is"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Full body"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "description": "`gym` or `home`",
            "example": "gym"
          },
          "updated_at": {
            "type": "string",
            "nullable": true,
            "description": "ISO 8601",
            "example": "2026-10-21T09:00:00+00:00"
          },
          "workout_duration": {
            "type": "integer",
            "description": "Minutes",
            "example": 60
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutSummary"
            },
            "description": "In rotation order: the first is up next"
          }
        },
        "required": [
          "created_at",
          "description",
          "experience_level",
          "frequency",
          "goal",
          "id",
          "is_active",
          "name",
          "note",
          "place",
          "updated_at",
          "workout_duration",
          "workouts"
        ]
      },
      "WorkoutSummary": {
        "type": "object",
        "properties": {
          "exercise_count": {
            "type": "integer",
            "example": 5
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Day A"
          },
          "order": {
            "type": "integer",
            "description": "Position in the rotation: 1 is up next",
            "example": 1
          }
        },
        "required": [
          "exercise_count",
          "id",
          "name",
          "order"
        ]
      },
      "WeightUnit": {
        "type": "string",
        "enum": [
          "kg",
          "lbs"
        ],
        "description": "The unit of every weight in the response: `kg` (metric) or `lbs` (us, uk). Weights are as stored, never converted"
      },
      "PlanWorkout": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Legs and pulls"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanExercise"
            },
            "description": "In order"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Day A"
          },
          "order": {
            "type": "integer",
            "description": "Position in the rotation: 1 is up next",
            "example": 1
          }
        },
        "required": [
          "description",
          "exercises",
          "id",
          "name",
          "order"
        ]
      },
      "PlanExercise": {
        "type": "object",
        "properties": {
          "exercise_slug": {
            "type": "string",
            "description": "The Exercise Library's key for the Exercise; its name, muscle groups and media come from the Exercise Library API",
            "example": "barbell-back-squat"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer",
            "example": 1
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanSet"
            },
            "description": "In order"
          }
        },
        "required": [
          "exercise_slug",
          "id",
          "order",
          "sets"
        ]
      },
      "PlanSet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer",
            "example": 1
          },
          "reps_recommended": {
            "type": "integer",
            "example": 8
          },
          "rest_recommended": {
            "type": "integer",
            "description": "Seconds",
            "example": 120
          },
          "weight_recommended": {
            "type": "number",
            "description": "In the response's `weight_unit`",
            "example": 80.5
          }
        },
        "required": [
          "id",
          "order",
          "reps_recommended",
          "rest_recommended",
          "weight_recommended"
        ]
      },
      "Plan": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "nullable": true,
            "description": "ISO 8601",
            "example": "2026-10-20T09:00:00+00:00"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Three full-body days"
          },
          "experience_level": {
            "type": "string",
            "description": "`beginner`, `intermediate` or `advanced`",
            "example": "intermediate"
          },
          "frequency": {
            "type": "integer",
            "description": "Workouts a week",
            "example": 3
          },
          "goal": {
            "type": "string",
            "example": "build_muscle"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean",
            "description": "The User's active Plan; at most one is"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Full body"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "description": "`gym` or `home`",
            "example": "gym"
          },
          "updated_at": {
            "type": "string",
            "nullable": true,
            "description": "ISO 8601",
            "example": "2026-10-21T09:00:00+00:00"
          },
          "workout_duration": {
            "type": "integer",
            "description": "Minutes",
            "example": 60
          },
          "weight_unit": {
            "$ref": "#/components/schemas/WeightUnit"
          },
          "workouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanWorkout"
            },
            "description": "In rotation order: the first is up next"
          }
        },
        "required": [
          "created_at",
          "description",
          "experience_level",
          "frequency",
          "goal",
          "id",
          "is_active",
          "name",
          "note",
          "place",
          "updated_at",
          "workout_duration",
          "weight_unit",
          "workouts"
        ]
      },
      "ProfileChanges": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120,
            "example": 31
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 300,
            "description": "In the height unit of the resulting measurement system: `cm` (metric) or `in` (us, uk); at most 2 decimals",
            "example": 171
          },
          "measurement_system": {
            "type": "string",
            "enum": [
              "metric",
              "us",
              "uk"
            ],
            "description": "Changing it converts every stored height and weight of the User (the Profile's, every Plan's set targets and every Workout Session's weights) to the new system's units, rounded to 2 decimals. Between `us` and `uk`, which share units, nothing is converted."
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 1000,
            "description": "In the weight unit of the resulting measurement system: `kg` (metric) or `lbs` (us, uk); at most 2 decimals",
            "example": 61.5
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/client-config": {
      "get": {
        "summary": "Mobile client config",
        "responses": {
          "200": {
            "description": "The mobile app's config: its minimum version per platform",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "public, max-age=300, s-maxage=300"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          }
        }
      }
    },
    "/v1/coach/models": {
      "get": {
        "summary": "Coach models",
        "responses": {
          "200": {
            "description": "Every model the Coach accepts, in list order",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "public, max-age=300, s-maxage=300"
                },
                "required": true
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachModels"
                }
              }
            }
          }
        }
      }
    },
    "/v1/muscle-groups": {
      "get": {
        "summary": "List muscle groups",
        "responses": {
          "200": {
            "description": "Every muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MuscleGroupItem"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/muscle-groups/{muscleGroup}": {
      "get": {
        "summary": "Get one muscle group",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/MuscleGroup"
            },
            "required": true,
            "name": "muscleGroup",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MuscleGroupItem"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such muscle group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plans": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List the User's Plans",
        "responses": {
          "200": {
            "description": "Every Plan of the User, newest first (not paged)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlanSummary"
                      },
                      "description": "The User's Plans, newest first"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plans/active": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get the User's active Plan",
        "responses": {
          "200": {
            "description": "The User's active Plan in full, or `null` without one",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "created_at": {
                          "type": "string",
                          "nullable": true,
                          "description": "ISO 8601",
                          "example": "2026-10-20T09:00:00+00:00"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "example": "Three full-body days"
                        },
                        "experience_level": {
                          "type": "string",
                          "description": "`beginner`, `intermediate` or `advanced`",
                          "example": "intermediate"
                        },
                        "frequency": {
                          "type": "integer",
                          "description": "Workouts a week",
                          "example": 3
                        },
                        "goal": {
                          "type": "string",
                          "example": "build_muscle"
                        },
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "is_active": {
                          "type": "boolean",
                          "description": "The User's active Plan; at most one is"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true,
                          "example": "Full body"
                        },
                        "note": {
                          "type": "string",
                          "nullable": true
                        },
                        "place": {
                          "type": "string",
                          "description": "`gym` or `home`",
                          "example": "gym"
                        },
                        "updated_at": {
                          "type": "string",
                          "nullable": true,
                          "description": "ISO 8601",
                          "example": "2026-10-21T09:00:00+00:00"
                        },
                        "workout_duration": {
                          "type": "integer",
                          "description": "Minutes",
                          "example": 60
                        },
                        "weight_unit": {
                          "$ref": "#/components/schemas/WeightUnit"
                        },
                        "workouts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PlanWorkout"
                          },
                          "description": "In rotation order: the first is up next"
                        }
                      },
                      "required": [
                        "created_at",
                        "description",
                        "experience_level",
                        "frequency",
                        "goal",
                        "id",
                        "is_active",
                        "name",
                        "note",
                        "place",
                        "updated_at",
                        "workout_duration",
                        "weight_unit",
                        "workouts"
                      ],
                      "description": "The User's active Plan, `null` without one"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plans/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get one of the User's Plans",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "in": "path",
            "name": "id"
          }
        ],
        "responses": {
          "200": {
            "description": "The Plan in full: its Workouts, their Exercises and sets, each in order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Plan"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`: the id isn't a uuid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such Plan, it was deleted, or it isn't the User's",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get the User's Profile",
        "responses": {
          "200": {
            "description": "The User's Profile, or `null` without one",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "age": {
                          "type": "number",
                          "example": 30
                        },
                        "gender": {
                          "type": "string",
                          "example": "female"
                        },
                        "height": {
                          "type": "number",
                          "description": "In `units.height`",
                          "example": 170.5
                        },
                        "measurement_system": {
                          "type": "string",
                          "description": "`metric`, `us` or `uk`",
                          "example": "metric"
                        },
                        "units": {
                          "type": "object",
                          "properties": {
                            "height": {
                              "type": "string",
                              "description": "`cm` (metric) or `in` (us, uk)",
                              "example": "cm"
                            },
                            "weight": {
                              "type": "string",
                              "description": "`kg` (metric) or `lbs` (us, uk)",
                              "example": "kg"
                            }
                          },
                          "required": [
                            "height",
                            "weight"
                          ],
                          "description": "The units every height and weight of the User is stored and shown in"
                        },
                        "weight": {
                          "type": "number",
                          "description": "In `units.weight`",
                          "example": 60.25
                        }
                      },
                      "required": [
                        "age",
                        "gender",
                        "height",
                        "measurement_system",
                        "units",
                        "weight"
                      ],
                      "description": "The User's Profile, `null` until they finish onboarding"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "description": "Changes only the given fields. A new `measurement_system` first converts every stored height and weight of the User (the Profile's, every Plan's set targets and every Workout Session's weights) to the new system's units, then writes the given `height` and `weight` as they are, in the new system's units. Repeating the same request changes nothing more.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update the User's Profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileChanges"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated Profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "age": {
                          "type": "number",
                          "example": 30
                        },
                        "gender": {
                          "type": "string",
                          "example": "female"
                        },
                        "height": {
                          "type": "number",
                          "description": "In `units.height`",
                          "example": 170.5
                        },
                        "measurement_system": {
                          "type": "string",
                          "description": "`metric`, `us` or `uk`",
                          "example": "metric"
                        },
                        "units": {
                          "type": "object",
                          "properties": {
                            "height": {
                              "type": "string",
                              "description": "`cm` (metric) or `in` (us, uk)",
                              "example": "cm"
                            },
                            "weight": {
                              "type": "string",
                              "description": "`kg` (metric) or `lbs` (us, uk)",
                              "example": "kg"
                            }
                          },
                          "required": [
                            "height",
                            "weight"
                          ],
                          "description": "The units every height and weight of the User is stored and shown in"
                        },
                        "weight": {
                          "type": "number",
                          "description": "In `units.weight`",
                          "example": 60.25
                        }
                      },
                      "required": [
                        "age",
                        "gender",
                        "height",
                        "measurement_system",
                        "units",
                        "weight"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`: the changes aren't valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`profile_not_found`: the User has no Profile yet; nothing was changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body isn't `application/json`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
