# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (a local toggle); a variable
# Infisical holds always wins over it.

PORT=3006

# Build time: the library.json bundle `pnpm generate` builds from (absolute,
# or relative to apps/library). Unset: the committed fixture,
# fixtures/library.json. A production build fetches library.json from the
# private Blob store instead.
LIBRARY_BUNDLE=

# Build time: the https origin of the Supabase project whose `exercise-media`
# bucket holds the media. Required on Vercel; unset elsewhere, media URLs
# point at a placeholder project.
SUPABASE_URL=

# Each Clerk instance's PEM public key (pnpm --silent db clerk:jwt-key
# [domain]). A session token verified by either one is a User's. Unset: that
# instance's tokens are refused.
CLERK_JWT_KEY_PRODUCTION=
CLERK_JWT_KEY_DEVELOPMENT=

# The Public API's, Arnold's and the MCP server's bearer secrets, at least 32
# characters (openssl rand -hex 32), each the same value as its caller's.
# Unset or shorter: that secret accepts nothing.
LIBRARY_PUBLIC_API_SECRET=
LIBRARY_ARNOLD_SECRET=
LIBRARY_MCP_SECRET=

# Upstash Redis, where each User's requests are counted (120 a minute). Unset
# outside production: an in-memory limiter; unset in production fails at
# startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The fitme-library Sentry project. Unset (local, tests, CI): nothing is sent.
SENTRY_DSN=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Production build only, set by Vercel once the Blob store is connected:
# the store holding library.json and the OIDC token that reads it.
# BLOB_READ_WRITE_TOKEN is the fallback when OIDC isn't available.
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Set by Vercel, never by hand: each event's environment and release.
# VERCEL=
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
