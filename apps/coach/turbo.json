{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".output/**", ".vercel/output/**"],
      // The build uploads its source maps for the commit's release, so a new
      // commit never replays another commit's output (whose upload never ran
      // for it).
      "env": ["VERCEL", "VERCEL_GIT_COMMIT_SHA"]
    }
  }
}
