PORT=3004

# Signing secret of the Clerk webhook endpoint (whsec_…) that sends
# user.deleted to POST /clerk. Without it every delivery answers 500 (reported
# to Sentry), so Clerk keeps retrying until it is set.
CLERK_WEBHOOK_SIGNING_SECRET=

# The fitme login's Supavisor transaction-pooler connection string; must carry
# application_name. Service-role strength: server environments only. Locally,
# the pooler port comes from `supabase status --output-format json`
# (endpoints."pooler.sql"); the password is from supabase/roles.sql.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=webhooks

# The fitme-webhooks Sentry project: errors (failed cleanups, unhandled
# errors) and request traces go here, through @fitme/observability. Unset
# (local, tests, CI): nothing is sent, errors only reach the logs.
SENTRY_DSN=

# Build only: uploads the bundle's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with. Unset: development, no
# release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=

# Arnold (apps/arnold) and the secret it accepts on its session reset route
# (its ARNOLD_RESET_SECRET, same value). A deleted User's Arnold sessions are
# reset through it; without them, deleting a User who has any answers 500
# (reported), so Clerk keeps retrying.
ARNOLD_URL=http://localhost:3005
ARNOLD_RESET_SECRET=
