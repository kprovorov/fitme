PORT=3004

# Signing secret of the Clerk webhook endpoint (whsec_…) that sends
# user.deleted to POST /clerk. Without it every delivery answers 500 (reported
# to Sentry), so Clerk keeps retrying until it is set.
CLERK_WEBHOOK_SIGNING_SECRET=

# The fitme login's Supavisor transaction-pooler connection string; must carry
# application_name. Service-role strength: server environments only. Locally,
# the pooler port comes from `supabase status --output-format json`
# (endpoints."pooler.sql"); the password is from supabase/roles.sql.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=webhooks

# Failed cleanups are reported here. Unset: Sentry is off, errors only reach
# the logs.
SENTRY_DSN=

# The Coach (apps/coach) and the secret it accepts on its session reset route
# (its COACH_RESET_SECRET, same value). A deleted User's Coach sessions are
# reset through it; without them, deleting a User who has any answers 500
# (reported), so Clerk keeps retrying.
COACH_URL=http://localhost:3005
COACH_RESET_SECRET=
