# Copy to .env.local: `eve dev` (pnpm dev:arnold) loads it. Deployed, set these
# in the Vercel project's environment (all but AI_GATEWAY_API_KEY).

# The Clerk instance's PEM public key; the channel verifies session tokens
# against it, networkless. `pnpm --silent db clerk:jwt-key` prints the
# development instance's (clerk.fitmeproject.com for production). Keep the
# newlines as \n inside the quotes. Unset: every request with a token fails.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"

# The fitme login's Supavisor transaction-pooler connection string; must carry
# application_name. Service-role strength: server environments only. Locally,
# the pooler port comes from `supabase status --output-format json`
# (endpoints."pooler.sql"); the password is from supabase/roles.sql.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=coach

# RevenueCat's secret API key (v1, sk_…; Project settings → API keys). The
# channel checks the "Fitme Pro" entitlement with it before every request.
# Server-only: never in the app. Unset: every request with a token fails with
# coach_pro_check_unavailable (503).
REVENUECAT_SECRET_KEY=

# Every model call goes through Vercel AI Gateway, paid with Gateway credits.
# Local only (`pnpm dev:arnold`, `pnpm arnold eval`): an AI Gateway API key from
# Vercel → provorovdev → AI Gateway → API Keys (`fitme-coach-local`, FIT-127).
# Deployed, leave it unset: the Coach authenticates through Vercel OIDC.
AI_GATEWAY_API_KEY=

# The fitme-coach Sentry project: failed steps, turns and sessions, turn-limit
# and guard failures. Its public key also authenticates the trace export.
# Unset (local): errors only reach the logs and no trace is exported.
SENTRY_DSN=

# Sentry's OTLP traces endpoint for the project (set on Vercel by the Sentry
# integration). Turns, steps and tool calls go there, metadata only. Unset
# (local, evals): nothing is exported.
SENTRY_OTLP_TRACES_URL=

# Build time, on Vercel (set by the Sentry integration): source map upload for
# the release. No token: the upload is skipped, the build still passes.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Shared with apps/webhooks (its ARNOLD_RESET_SECRET, same value; `openssl rand
# -hex 32`): it resets a deleted User's sessions with it, and it works on the
# reset route only. Unset or empty, the pre-rename COACH_RESET_SECRET is read
# instead. Unset (or under 32 characters): nothing is accepted over it.
ARNOLD_RESET_SECRET=

# The Exercise Library API (apps/exercises): search_exercises lists through it,
# Exercise slugs are checked against it before any write, and reads get
# Exercise names from it. Locally, `pnpm dev:exercises` on :3006 with the same
# EXERCISES_ARNOLD_SECRET in apps/exercises/.env (this local-only value, never
# production's; unset or empty, the pre-rename EXERCISES_COACH_SECRET is read). Deployed: https://exercises.fitmeproject.com and its secret.
# Unset URL: every Exercise Library call fails (writes refused, reads named
# from slugs).
EXERCISES_URL=http://localhost:3006
EXERCISES_ARNOLD_SECRET=local-only-arnold-secret-000000000000000
