# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (the worktree's database URL, a
# local toggle); a variable Infisical holds always wins over it.
# `eve dev` (pnpm dev:arnold) loads that local file, `.env`. Deployed, set
# these in the Vercel project's environment (all but AI_GATEWAY_API_KEY).

# The Clerk instance's PEM public key (pnpm --silent db clerk:jwt-key); the
# channel verifies session tokens against it, networkless. Unset: every
# request with a token fails.
CLERK_JWT_KEY=

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=arnold. Not in Infisical: it's this worktree's own stack, and
# scripts/setup.sh writes it into .env with the stack's real pooler port (the
# password is the local-only one from supabase/roles.sql). Service-role
# strength: server environments only.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=arnold

# RevenueCat's secret API key (v1, sk_…): the channel checks the "Fitme Pro"
# entitlement with it. Unset: every request with a token fails with
# arnold_pro_check_unavailable (503).
REVENUECAT_SECRET_KEY=

# Local only (pnpm dev:arnold, pnpm arnold eval): a Vercel AI Gateway API key
# (provorovdev → AI Gateway → API Keys). Deployed, leave it unset: Arnold
# authenticates through Vercel OIDC.
AI_GATEWAY_API_KEY=

# Shared with apps/webhooks (its ARNOLD_RESET_SECRET, same value): it resets a
# deleted User's sessions with it, on the reset route only. Unset (or under 32
# characters): nothing is accepted over it.
ARNOLD_RESET_SECRET=

# The Library API (apps/library, pnpm dev:library) and Arnold's bearer for it
# (the same value as the Library API's LIBRARY_ARNOLD_SECRET). Unset URL:
# every Library call fails.
LIBRARY_URL=http://localhost:3006
LIBRARY_ARNOLD_SECRET=

# The fitme-arnold Sentry project; its public key also authenticates the trace
# export. Unset (local): errors only reach the logs.
SENTRY_DSN=

# Sentry's OTLP traces endpoint (set on Vercel by the Sentry integration).
# Unset (local, evals): no trace is exported.
SENTRY_OTLP_TRACES_URL=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment and release of every event,
# and the traces' deployment.environment.
# VERCEL=
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
