{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".output/**", ".vercel/output/**"],
      // A Vercel build is its commit's own: never replay another commit's
      // output.
      "env": ["VERCEL", "VERCEL_GIT_COMMIT_SHA"]
    }
  }
}
