# Every variable this app reads. Nothing of it is in Infisical
# (docs/agents/secrets.md, Not in Infisical yet): a local `.env` holds only the
# database URL.

# The fitme login's Supavisor transaction-pooler connection string, with
# application_name=jobs. Locally it's this worktree's own stack, and
# scripts/setup.sh writes it into .env with the stack's real pooler port (the
# password is the local-only one from supabase/roles.sql). Service-role
# strength: server environments only. Unset: every run fails.
FITME_DATABASE_URL=postgresql://fitme.pooler-dev:fitme-local-only@127.0.0.1:<pooler port>/postgres?application_name=jobs

# The fitme-jobs Sentry project. Unset (local, tests, CI): nothing is sent.
SENTRY_DSN=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: each event's environment and release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
