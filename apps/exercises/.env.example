PORT=3006

# The library.json bundle `pnpm generate` builds the API from (absolute, or
# relative to apps/exercises). Unset: the committed fixture,
# fixtures/library.json, of made-up Exercises. A production build on Vercel
# (VERCEL_ENV=production) ignores it and fetches library.json from the private
# Blob store instead (BLOB_STORE_ID and VERCEL_OIDC_TOKEN, set by Vercel).
LIBRARY_BUNDLE=

# The Supabase project whose `exercise-media` bucket holds the media. Read at
# build time (`pnpm generate`, run by dev, build, typecheck and test). Required
# on Vercel; unset anywhere else, media URLs point at a placeholder project.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Each Clerk instance's PEM public key (`pnpm --silent db clerk:jwt-key
# [domain]`, or Clerk dashboard → API keys → JWT public key). A session token
# verified by either one is a User's. Unset, that instance's tokens are refused.
CLERK_JWT_KEY_PRODUCTION="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
CLERK_JWT_KEY_DEVELOPMENT="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# The Public API's, Arnold's and the MCP server's bearer secrets, at least 32
# characters (`openssl rand -hex 32`). Unset or shorter, a secret accepts
# nothing. The values here are local-only, for apps/api and apps/arnold to send
# the same ones (LIBRARY_PUBLIC_API_SECRET, LIBRARY_ARNOLD_SECRET in
# their .env.example); production's are only on Vercel. EXERCISES_ARNOLD_SECRET unset
# or empty, the pre-rename EXERCISES_COACH_SECRET is read instead.
EXERCISES_API_SECRET=local-only-exercises-api-secret-0000000000000000
EXERCISES_ARNOLD_SECRET=local-only-arnold-secret-000000000000000
EXERCISES_MCP_SECRET=

# Upstash Redis (Vercel Marketplace), where each User's requests are counted:
# 120 per minute per Clerk User, server callers never. Unset outside
# production, an in-memory limiter counts per process; in production (NODE_ENV
# production) unset fails at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The fitme-exercises Sentry project: errors (unhandled errors, rate-limiter
# failures) and request traces go here, through @fitme/observability, with the
# User as their Clerk id only. Unset (local, tests, CI): nothing is sent,
# errors only reach the logs.
SENTRY_DSN=

# Build only: uploads the bundle's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production) and the release
# (the commit) every event is tagged with. Unset: development, no release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
