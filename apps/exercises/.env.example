PORT=3006

# The library.json bundle `pnpm generate` builds the API from (absolute, or
# relative to apps/exercises). Unset: the committed fixture,
# fixtures/library.json, of made-up Exercises.
LIBRARY_BUNDLE=

# The Supabase project whose `exercise-media` bucket holds the media. Read at
# build time (`pnpm generate`, run by dev, build, typecheck and test). Required
# on Vercel; unset anywhere else, media URLs point at a placeholder project.
# SUPABASE_URL=https://<project-ref>.supabase.co

# Each Clerk instance's PEM public key (`pnpm --silent db clerk:jwt-key
# [domain]`, or Clerk dashboard → API keys → JWT public key). A session token
# verified by either one is a User's. Unset, that instance's tokens are refused.
CLERK_JWT_KEY_PRODUCTION="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
CLERK_JWT_KEY_DEVELOPMENT="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# The Coach's and the MCP server's bearer secrets, at least 32 characters
# (`openssl rand -hex 32`). Unset or shorter, a secret accepts nothing.
EXERCISES_COACH_SECRET=
EXERCISES_MCP_SECRET=

# Upstash Redis (Vercel Marketplace), where each User's requests are counted:
# 120 per minute per Clerk User, server callers never. Unset outside
# production, an in-memory limiter counts per process; in production (NODE_ENV
# production) unset fails at startup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Unhandled errors and rate-limiter failures are reported here; unset, they
# only reach the logs.
SENTRY_DSN=
