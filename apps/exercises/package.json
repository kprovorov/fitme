{
  "name": "@fitme/exercises",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate && tsdown",
    "dev": "pnpm generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "generate": "tsx --env-file-if-exists=.env src/generate.ts",
    "openapi": "tsx src/openapi.ts",
    "start": "node dist/node/index.js",
    "test": "pnpm generate && vitest run",
    "test:watch": "pnpm generate && vitest",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@fitme/core": "workspace:*",
    "@fitme/observability": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "^11.8.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.1",
    "hono": "^4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vercel/blob": "^2.8.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
