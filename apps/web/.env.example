# apps/api, the Public API: every read of User data goes through it.
# Server-only (no NEXT_PUBLIC_): only Server Components call it. Unset: the
# dashboard shows its error state.
PUBLIC_API_URL=http://localhost:3003

# Clerk (development instance locally)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The fitme-web Sentry project: browser and server errors and traces.
# Unset (local, CI): nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=

# Build only: uploads the build's source maps to SENTRY_ORG / SENTRY_PROJECT
# for the release (VERCEL_GIT_COMMIT_SHA). Set on Vercel by the Sentry
# integration. Unset: the build skips the upload and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: the environment (production, preview) and the
# release (the commit) every event is tagged with. Unset: development, no
# release.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
