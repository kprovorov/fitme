# Every variable this app reads. Secrets are empty here: real dev values live
# in Infisical `dev` (this app's folder) and are injected when the app starts
# through the launcher helper (docs/agents/secrets.md). A local `.env` beside
# the app holds only what Infisical doesn't (a local toggle); a variable
# Infisical holds always wins over it.

# The Public API (apps/api, pnpm dev:api): every read of User data goes
# through it. Server-only (no NEXT_PUBLIC_). Unset: the dashboard shows its
# error state.
PUBLIC_API_URL=http://localhost:3003

# Clerk (the development instance locally).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The fitme-web Sentry project, browser and server. Unset (local, CI): nothing
# is sent.
NEXT_PUBLIC_SENTRY_DSN=

# Build only: source map upload for the release. Set on Vercel by the Sentry
# integration. Unset: the upload is skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set by Vercel, never by hand: each event's environment and release, inlined
# into the browser bundle.
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=
