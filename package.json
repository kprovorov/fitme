{
  "name": "fitme",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "android": "pnpm --filter @fitme/mobile android",
    "api": "pnpm --filter @fitme/api",
    "api-client": "pnpm --filter @fitme/api-client",
    "arnold": "pnpm --filter @fitme/arnold",
    "build": "turbo run build",
    "check": "ultracite check",
    "db": "pnpm --filter @fitme/supabase",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@fitme/api",
    "dev:arnold": "turbo run dev --filter=@fitme/arnold",
    "dev:library": "turbo run dev --filter=@fitme/library",
    "dev:mcp": "turbo run dev --filter=@fitme/mcp",
    "dev:mobile": "turbo run dev --filter=@fitme/mobile",
    "dev:site": "turbo run dev --filter=@fitme/site",
    "dev:web": "turbo run dev --filter=@fitme/web",
    "dev:webhooks": "turbo run dev --filter=@fitme/webhooks",
    "fix": "ultracite fix",
    "ios": "pnpm --filter @fitme/mobile ios",
    "knip": "knip --no-progress",
    "library": "pnpm --filter @fitme/library",
    "lint": "turbo run lint",
    "literal-check": "pnpm --filter @fitme/design-tokens literal-check",
    "mcp": "pnpm --filter @fitme/mcp",
    "mobile": "pnpm --filter @fitme/mobile",
    "prepare": "husky",
    "site": "pnpm --filter @fitme/site",
    "test": "turbo run test",
    "test:hooks": "node --test .claude/hooks/shell-rules.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "text-check": "pnpm --filter @fitme/i18n text-check",
    "typecheck": "turbo run typecheck",
    "web": "pnpm --filter @fitme/web",
    "webhooks": "pnpm --filter @fitme/webhooks"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "eslint-plugin-github": "6.1.2",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.21",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "turbo": "^2.11.9",
    "typescript": "~5.9.2",
    "ultracite": "8.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm exec ultracite fix"
    ]
  },
  "engines": {
    "node": "^24.3.0 || >=25.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
