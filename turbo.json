{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [
    "biome.jsonc",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig*.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "SUPABASE_*", "LIBRARY_BUNDLE"],
      "passThroughEnv": [
        "SENTRY_*",
        "FITME_DATABASE_URL",
        "CLERK_*",
        "COACH_RESET_SECRET",
        "COACH_URL",
        "REVENUECAT_SECRET_KEY",
        "MIN_APP_VERSION",
        "MIN_APP_VERSION_*",
        "MCP_PUBLIC_URL",
        "VERCEL",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "prebuild": {
      "cache": false,
      "env": ["EXPO_PUBLIC_*", "SENTRY_*"]
    }
  }
}
