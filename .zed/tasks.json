[
  {
    "label": "Setup",
    "command": "./scripts/setup.sh",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Destroy Supabase stack",
    "command": "./scripts/settle.sh",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Run all",
    "command": "pnpm",
    "args": ["dev"],
    "reveal": "no_focus"
  },
  {
    "label": "Run mobile",
    "command": "pnpm",
    "args": ["mobile", "dev"],
    "reveal": "no_focus"
  },
  {
    "label": "Build mobile",
    "command": "pnpm",
    "args": ["ios", "--no-bundler"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Release iOS (local)",
    "command": "./scripts/release-ios-local.sh"
  },
  {
    "label": "Preview iOS (local)",
    "command": "./scripts/preview-ios-local.sh"
  },
  {
    "label": "Run web",
    "command": "pnpm",
    "args": ["dev:web"],
    "reveal": "no_focus"
  },
  {
    "label": "Run site",
    "command": "pnpm",
    "args": ["dev:site"],
    "reveal": "no_focus"
  },
  {
    "label": "Run MCP",
    "command": "pnpm",
    "args": ["dev:mcp"],
    "reveal": "no_focus"
  },
  {
    "label": "Run API",
    "command": "pnpm",
    "args": ["dev:api"],
    "reveal": "no_focus"
  },
  {
    "label": "Run webhooks",
    "command": "pnpm",
    "args": ["dev:webhooks"],
    "reveal": "no_focus"
  },
  {
    "label": "Run arnold",
    "command": "pnpm",
    "args": ["dev:arnold"],
    "reveal": "no_focus"
  },
  {
    "label": "Run library",
    "command": "pnpm",
    "args": ["dev:library"],
    "reveal": "no_focus"
  },
  {
    "label": "Start Supabase",
    "command": "pnpm",
    "args": ["db", "start"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Test",
    "command": "pnpm",
    "args": ["test"]
  },
  {
    "label": "Watch mobile tests",
    "command": "pnpm",
    "args": ["--filter", "@fitme/mobile", "test:watch"]
  },
  {
    "label": "Watch web tests",
    "command": "pnpm",
    "args": ["--filter", "@fitme/web", "exec", "vitest"]
  },
  {
    "label": "Check UI literals",
    "command": "pnpm",
    "args": ["literal-check"]
  },
  {
    "label": "Check translations",
    "command": "pnpm",
    "args": ["text-check"]
  },
  {
    "label": "Check",
    "command": "pnpm check && pnpm typecheck"
  },
  {
    // Runs automatically after Zed creates a new git worktree.
    // $ZED_WORKTREE_ROOT is the new worktree's root directory, and
    // $ZED_MAIN_GIT_WORKTREE is the original repository's working directory.
    "label": "Set up new worktree",
    "command": "./scripts/setup.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
