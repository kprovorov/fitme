[
  {
    "label": "Mobile: Run iOS",
    "command": "pnpm",
    "args": ["mobile", "ios"],
    "reveal": "no_focus"
  },
  {
    "label": "Mobile: Dev",
    "command": "pnpm",
    "args": ["dev:mobile"],
    "reveal": "no_focus"
  },
  {
    "label": "Web: Dev",
    "command": "pnpm",
    "args": ["dev:web"],
    "reveal": "no_focus"
  },
  {
    "label": "Mobile: Prebuild",
    "command": "pnpm",
    "args": ["mobile", "prebuild", "--clean"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Start",
    "command": "pnpm",
    "args": ["db", "start"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Restart",
    "command": "pnpm db stop && pnpm db start",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Migrate",
    "command": "pnpm",
    "args": ["db", "migrate"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Serve Functions",
    "command": "pnpm",
    "args": ["db", "functions:serve"],
    "reveal": "no_focus"
  }
]
