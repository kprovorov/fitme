[
  {
    "label": "Expo: Run iOS",
    "command": "npm",
    "args": ["run", "ios"],
    "reveal": "no_focus"
  },
  {
    "label": "Expo: Dev",
    "command": "npm",
    "args": ["run", "dev"],
    "reveal": "no_focus"
  },
  {
    "label": "Expo: Prebuild",
    "command": "npx",
    "args": ["expo", "prebuild", "--clean"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Start",
    "command": "supabase start",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Restart",
    "command": "supabase stop && supabase start",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Migrate",
    "command": "supabase",
    "args": ["migration", "up"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Supabase: Serve Functions",
    "command": "supabase",
    "args": ["functions", "serve"],
    "reveal": "no_focus"
  }
]
