[
  {
    "label": "Setup",
    "command": "./.t3/setup.sh",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Destroy Supabase stack",
    "command": "./.t3/settle.sh",
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Run all",
    "command": "pnpm",
    "args": ["dev"],
    "reveal": "no_focus"
  },
  {
    "label": "Run mobile",
    "command": "pnpm",
    "args": ["mobile", "dev"],
    "reveal": "no_focus"
  },
  {
    "label": "Build mobile",
    "command": "pnpm",
    "args": ["ios", "--no-bundler"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Run web",
    "command": "pnpm",
    "args": ["dev:web"],
    "reveal": "no_focus"
  },
  {
    "label": "Run site",
    "command": "pnpm",
    "args": ["dev:site"],
    "reveal": "no_focus"
  },
  {
    "label": "Run MCP",
    "command": "pnpm",
    "args": ["dev:mcp"],
    "reveal": "no_focus"
  },
  {
    "label": "Run API",
    "command": "pnpm",
    "args": ["dev:api"],
    "reveal": "no_focus"
  },
  {
    "label": "Run webhooks",
    "command": "pnpm",
    "args": ["dev:webhooks"],
    "reveal": "no_focus"
  },
  {
    "label": "Run arnold",
    "command": "pnpm",
    "args": ["dev:arnold"],
    "reveal": "no_focus"
  },
  {
    "label": "Start Supabase",
    "command": "pnpm",
    "args": ["db", "start"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Test",
    "command": "pnpm",
    "args": ["test"]
  },
  {
    "label": "Check",
    "command": "pnpm check && pnpm typecheck"
  }
]
