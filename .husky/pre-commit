# Secret scan of the staged changes (.gitleaks.toml): a finding fails the
# commit. A machine without gitleaks only gets a warning; CI scans every PR.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
else
  echo "warning: gitleaks not installed, skipping the secret scan (brew install gitleaks)" >&2
fi

# A conflict marker left in the staged changes fails the commit (AGENTS.md
# Git: resolve each conflict hunk by hand).
markers=$(git diff --cached --no-color -U0 | grep -E '^\+(<<<<<<<|>>>>>>>|\|\|\|\|\|\|\|)( |$)' || true)
if [ -n "$markers" ]; then
  echo "error: conflict markers in the staged changes:" >&2
  echo "$markers" >&2
  exit 1
fi

pnpm exec lint-staged
