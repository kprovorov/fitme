{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/jest"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      // Vendored agent skills (npx skills add): third-party code, hashed in skills-lock.json.
      "!.agents/skills",
      // Written by `pnpm openapi` (apps/api, apps/library); CI checks each is exactly what that writes.
      "!apps/api/openapi.json",
      "!apps/library/openapi.json",
      // Written by `pnpm generate`, never committed.
      "!apps/library/src/generated",
      // Written by uniwind's Metro plugin on every expo start; committed in its raw format.
      "!apps/mobile/uniwind-types.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off",
        "noExportedImports": "off",
        "noNestedTernary": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/public/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
