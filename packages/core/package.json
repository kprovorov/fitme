{
  "name": "@fitme/core",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-agnostic domain models, labels, formatters and helpers shared by every Fitme app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./covers": "./src/covers.ts",
    "./models": "./src/models.ts",
    "./labels": "./src/labels.ts",
    "./limits": "./src/limits.ts",
    "./names": "./src/names.ts",
    "./training-progress": "./src/training-progress.ts",
    "./formatters": "./src/formatters.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./workout-sessions": "./src/workout-sessions.ts",
    "./finish-suggestion": "./src/finish-suggestion.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
