{
  "name": "@fitme/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Fitme's translations: one catalog per App language, the i18next setup, the translation check and the text check.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
