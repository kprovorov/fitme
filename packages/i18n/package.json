    "test:watch": "vitest",
    "text-check": "node src/text-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fitme/core": "workspace:*",
    "i18next": "^26.5.11"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
