  "dependencies": {
    "@fitme/core": "workspace:*",
    "i18next": "^27.1.2"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
