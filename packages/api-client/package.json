{
  "name": "@fitme/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The Public API client shared by the mobile and web apps: the openapi-fetch client, ApiError and the types generated from apps/api's OpenAPI document.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json --output src/schema.ts && oxfmt --write src/schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
