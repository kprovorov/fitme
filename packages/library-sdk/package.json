{
  "name": "@fitme/library-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "The Library API client the mobile app reads Covers through, plus an in-memory fake for its tests.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fitme/core": "workspace:*"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
