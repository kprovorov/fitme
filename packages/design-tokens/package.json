{
  "name": "@fitme/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Fitme's design tokens: one Tailwind v4 @theme CSS file every app imports, and a reader that parses it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
