{
  "name": "@fitme/rate-limit",
  "version": "0.0.0",
  "private": true,
  "description": "The per-caller rate limiter shared by the backend apps: Upstash Redis or in memory, chosen from the environment, failing open when its store is down.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.1"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
