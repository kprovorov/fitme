{
  "name": "@fitme/db",
  "version": "0.0.0",
  "private": true,
  "description": "The only way backend apps reach Postgres: asUser and withService over the Supavisor transaction pooler (ADR 0003).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./local-database-url": "./integration/local-database-url.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "schema:generate": "tsx scripts/generate-schema.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
