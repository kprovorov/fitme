# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Clerk JWT public key that ai-agent verifies session tokens with (one
# line). For the development instance: pnpm --silent db clerk:jwt-key
CLERK_JWT_KEY=

# Signing secret of the Clerk webhook endpoint that sends user.deleted to
# clerk-webhook (whsec_…, from the endpoint in the Clerk dashboard)
CLERK_WEBHOOK_SIGNING_SECRET=

# Sentry DSN clerk-webhook reports failed cleanups to (optional)
SENTRY_DSN=
