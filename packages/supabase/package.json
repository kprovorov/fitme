{
  "name": "@fitme/supabase",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase project (config, migrations, seeds) plus generated database types.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database.types": "./src/database.types.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "clerk:check": "tsx scripts/check-clerk-trust.ts",
    "clerk:check-migration": "tsx scripts/check-clerk-migration.ts",
    "clerk:jwt-key": "tsx scripts/clerk-jwt-key.ts",
    "exercises:sync": "tsx supabase/sync.ts",
    "migrate": "supabase migration up",
    "reset": "supabase db reset",
    "seed": "tsx supabase/seed.ts",
    "seed:sync": "snaplet-seed sync",
    "start": "supabase start",
    "status": "supabase status",
    "stop": "supabase stop",
    "test:db": "supabase test db",
    "typecheck": "tsc --noEmit",
    "types:generate": "supabase gen types typescript --local --schema public > src/database.types.ts && biome check --write --unsafe src/database.types.ts",
    "users:migrate": "tsx scripts/migrate-users-to-clerk.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.98.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
