{
  "name": "@fitme/supabase",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase project (config, migrations, pgTAP tests) plus generated database types.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./database.types": "./src/database.types.ts"
  },
  "scripts": {
    "clerk:jwt-key": "tsx scripts/clerk-jwt-key.ts",
    "migrate": "supabase migration up",
    "reset": "supabase db reset",
    "start": "supabase start",
    "status": "supabase status",
    "stop": "supabase stop",
    "test:db": "supabase test db",
    "typecheck": "tsc --noEmit",
    "types:generate": "supabase gen types typescript --schema public > src/database.types.ts && oxfmt --write src/database.types.ts"
  },
  "devDependencies": {
    "@fitme/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
